# Add these in Render > Environment > Environment Variables.
# Never put real API keys in this file or commit them.
GROQ_API_KEY=
# GitHub Pages site origin; update if using a custom domain.
FRONTEND_ORIGIN=https://jaiveginati-creator.github.io
# Optional; defaults to openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-20b
